# Copy this file to .env and adjust the values if needed:
#   cp .env.example .env

# PostgreSQL connection string. The defaults match compose.yaml.
DATABASE_URL=postgres://benkyo:benkyo@localhost:5432/benkyo

# Host port for the Docker Compose database. If 5432 is already in use,
# set another port here and use the same port in DATABASE_URL.
# POSTGRES_PORT=5432
